---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  bare?: boolean;
  ogImage?: string;
  ogType?: string;
}

const {
  title = 'ProbablyFine',
  description = "A homelab + SRE engineering blog. Kubernetes, GitOps, and the occasional 3am incident. It's probably fine.",
  bare = false,
  ogImage: ogImageProp,
  ogType = 'website',
} = Astro.props;

const site = Astro.site ?? 'https://probablyfine.dev';
// Flat-file build (build.format 'file') makes Astro.url.pathname carry a .html
// suffix at build time, but nginx serves + everyone links the clean URL. Strip
// .html (and /index) so canonical/og:url match the real URL and don't signal
// duplicate content to search engines.
let cleanPath = Astro.url.pathname.replace(/\.html$/, '');
if (cleanPath.endsWith('/index')) cleanPath = cleanPath.slice(0, -'index'.length);
const canonical = new URL(cleanPath || '/', site);
const ogImage = new URL(ogImageProp ?? '/og.png?v=1', site);

// Structured data. WebSite + Person identity graph (deduped by @id); posts
// additionally emit their own BlogPosting graph from the post renderer.
const siteLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}/#website`,
      url: `${site}/`,
      name: 'ProbablyFine',
      description:
        "A homelab and SRE engineering blog. Kubernetes, GitOps, and the occasional 3am incident.",
      inLanguage: 'en',
    },
    {
      '@type': 'Person',
      '@id': `${site}/#maxfield`,
      name: 'Maxfield Allison',
      url: 'https://maxfieldallison.com',
      email: 'mailto:hello@maxfieldallison.com',
      sameAs: [
        'https://github.com/maxfield-allison',
        'https://www.linkedin.com/in/maxfield-allison/',
        'https://bsky.app/profile/maxfieldallison.com',
        'https://www.facebook.com/maxfield.allison',
        'https://maxfieldallison.com',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0e12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    {/* Self-hosted fonts. Preloaded because they are referenced from the CSS,
        which the browser only parses after fetching it — without these the
        first paint swaps fonts visibly. Both faces carry visible text above the
        fold here: mono does real work in the prompt grammar and session blocks,
        not just labels. */}
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="alternate" type="application/rss+xml" title="ProbablyFine" href={new URL('/rss.xml', site).href} />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
    <ClientRouter />
    {/* Self-hosted, privacy-friendly analytics (Umami on the homelab cluster).
        Served first-party from /pf-insights/* (proxied to Umami) so ad-blockers
        don't drop it as a third-party tracker domain. Tracker derives its collect
        endpoint from the script path, so it posts to /pf-insights/api/send. */}
    <script
      defer
      src="/pf-insights/script.js"
      data-website-id="500c4f8f-188b-4e0b-a804-5fecd412f118"
    ></script>
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    {
      bare ? (
        <slot />
      ) : (
        <>
          <a href="#main-content" class="skip-link">Skip to content</a>
          <Nav />
          <main id="main-content" tabindex="-1" class="flex-1">
            <slot />
          </main>
          <Footer />
        </>
      )
    }
  </body>
</html>
