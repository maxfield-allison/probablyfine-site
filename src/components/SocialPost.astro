---
import type { CollectionEntry } from 'astro:content';
import { socialDate } from '../lib/social';
interface Props { post: CollectionEntry<'social'>; standalone?: boolean }
const { post, standalone = false } = Astro.props;
const { title, date, caption, image, tags, processNote } = post.data;
---
<article class="social-post" data-pagefind-body={standalone ? true : undefined}>
  <header>
    <time datetime={date.toISOString()}>{socialDate(date)}</time>
    {standalone ? <h1>{title}</h1> : <h2><a href={`/social/${post.id}`}>{title}</a></h2>}
  </header>
  <p class="caption">{caption}</p>
  {image && <a href={image.src} aria-label="Open the full-size image" data-umami-event="social-image-open">
    <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" />
  </a>}
  <p class="tags">{tags.map(tag => <span>#{tag} </span>)}</p>
  <div class="actions">
    <a href={`/social/${post.id}`} data-track="social-permalink">Permalink</a>
    {image && <a href={image.src} download data-umami-event="social-image-download">Download image</a>}
    <a href="/blog" data-track="social-to-blog">Longer reads →</a>
  </div>
  <details><summary>Process note</summary><p>{processNote}</p></details>
</article>
<style>
  .social-post { max-width: 760px; padding: 2rem 0; border-top: 1px solid var(--color-line); }
  time,.tags { font-family: var(--font-mono,monospace); font-size:.85rem; color:var(--color-ink-dim); }
  h1,h2 { margin:.7rem 0 1.2rem; font-size:1.6rem; line-height:1.3; }
  h2 a { color:var(--color-ink); text-decoration:none; }
  .caption { white-space:pre-wrap; font-size:1.2rem; line-height:1.65; margin:0 0 1.5rem; }
  img { display:block; max-width:100%; height:auto; border:1px solid var(--color-line); border-radius:6px; }
  .actions { display:flex; flex-wrap:wrap; gap:1rem; margin:1rem 0; }
  .actions a,summary { min-height:44px; display:inline-flex; align-items:center; }
  summary { cursor:pointer; color:var(--color-ink-dim); text-decoration:underline; }
  details p { color:var(--color-ink-dim); line-height:1.6; }
</style>
