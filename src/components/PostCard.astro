---
// A post as a ledger row: date, title, tags, reading time. Dense on purpose —
// listing surfaces are where this site's density lives, while the post body
// itself keeps a generous measure. Shared by the blog index, the tag pages,
// and the home page so the archive reads the same everywhere.
import type { CollectionEntry } from 'astro:content';
import { readingTime, tagSlug } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  /** Show the full date rather than month-day. Month-grouped lists supply the
      year in their group header, so they pass false. */
  fullDate?: boolean;
}

const { post, fullDate = true } = Astro.props;
const { title, tags, date, aiRole } = post.data;
const iso = date.toISOString().slice(0, 10);
const mins = readingTime(post.body);
import { aiRoleLabel, aiRoleColor } from '../lib/aiRole';
---

<div class="group grid grid-cols-[4.5rem_minmax(0,1fr)] sm:grid-cols-[6.875rem_minmax(0,1fr)_auto] gap-x-5 gap-y-1 items-baseline py-5 border-b border-[var(--color-line)]">
  <time datetime={iso} class="font-mono text-xs text-[var(--color-ink-dim)]">
    {fullDate ? iso : iso.slice(5)}
  </time>
  <div class="min-w-0">
    <a href={`/blog/${post.id}`} class="no-underline hover:no-underline text-[var(--color-ink)]">
      <span class="text-[1.0625rem] font-semibold leading-snug hover:text-[var(--color-accent)] transition-colors">
        {title}
      </span>
    </a>
    <div class="mt-1.5 font-mono text-[11px] text-[var(--color-ink-dim)] flex flex-wrap gap-x-2">
      {tags.map((t) => (
        <a
          href={`/blog/tags/${tagSlug(t)}`}
          class="no-underline hover:no-underline text-[var(--color-ink-dim)] hover:text-[var(--color-accent)] transition-colors"
        >
          #{t}
        </a>
      ))}
      <a href="/ai" style={`color: ${aiRoleColor(aiRole)}`} class="no-underline hover:underline">{aiRoleLabel(aiRole)}</a>
    </div>
  </div>
  <div class="hidden sm:block font-mono text-[11px] text-[var(--color-ink-dim)] whitespace-nowrap">
    {mins} min
  </div>
</div>
