---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

// Keep the shared wordmark and visual identity. This site groups its growing
// collection of reading and interactive destinations in a smaller primary row.
interface NavLink {
  href: string;
  label: string;
  external?: boolean;
  umami?: string;
}

const links: NavLink[] = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/social', label: 'Social' },
  { href: '/labs', label: 'Labs' },
  { href: '/arcade', label: 'Arcade' },
  { href: '/chronochasm', label: 'Chronochasm', umami: 'chronochasm-link' },
  { href: '/now', label: 'Now' },
  { href: '/ai', label: 'AI' },
  { href: '/pets', label: 'Pets' },
  // Secondary on purpose: the primary row is for destinations, and /blog
  // carries its own link for readers who are already looking for a post.
  { href: '/search', label: 'Search' },
  { href: 'https://status.probablyfine.dev', label: 'Status', external: true, umami: 'outbound-status' },
  { href: 'https://maxfieldallison.com?utm_source=probablyfine&utm_medium=site', label: 'About me', external: true, umami: 'outbound-maxfieldallison' },
];

const primary = links.filter((l) => ['/blog', '/social', '/labs', '/arcade', '/chronochasm'].includes(l.href));
const secondary = links.filter((l) => l.href !== '/' && !primary.includes(l));

const linkClass = (l: NavLink) => [
  'no-underline hover:no-underline transition-colors',
  !l.external && isActive(l.href)
    ? 'text-[var(--color-ink)]'
    : 'text-[var(--color-ink-dim)] hover:text-[var(--color-ink)]',
];
const relFor = (l: NavLink) => (l.external ? 'noopener' : undefined);
---

<header
  class="sticky top-0 z-40 bg-[var(--color-base)] border-b border-[var(--color-line)] print:static"
>
  <nav aria-label="Primary" class="max-w-[var(--container-shell)] mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-mono text-sm text-[var(--color-ink)] no-underline hover:no-underline">
      probably<span class="text-[var(--color-accent)]">fine</span>
    </a>

    {/* Desktop: inline row */}
    <div class="hidden sm:flex items-center gap-6 font-mono text-sm">
      {
        primary.map((l) => (
          <a
            href={l.href}
            rel={relFor(l)}
            data-umami-event={l.external ? l.umami : undefined}
            data-track={l.external ? undefined : l.umami}
            data-track-where={l.href === '/chronochasm' ? 'site-nav' : undefined}
            data-track-destination={l.href === '/chronochasm' ? l.href : undefined}
            aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
            class:list={linkClass(l)}
          >
            {l.label}
          </a>
        ))
      }
      <details class="relative">
        <summary class="nav-disclosure cursor-pointer" data-umami-event="nav-menu">More <span aria-hidden="true">⌄</span></summary>
        <div class="nav-menu absolute right-0 top-full mt-2 z-50 rounded border border-[var(--color-line)] bg-[var(--color-surface)] p-2 flex flex-col shadow-lg">
          {secondary.map((l) => (
            <a href={l.href} rel={relFor(l)} data-umami-event={l.umami}
              aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
              class:list={['menu-link rounded hover:bg-[var(--color-base)]', ...linkClass(l)]}>{l.label}</a>
          ))}
        </div>
      </details>
    </div>

    {/* Mobile: no-JS disclosure menu. ClientRouter re-renders the header on
        navigation, so the menu resets to closed after each click. */}
    <details class="sm:hidden relative open:[&_.chev]:rotate-180">
      <summary
        data-umami-event="nav-menu"
        class="nav-disclosure list-none [&::-webkit-details-marker]:hidden cursor-pointer text-[var(--color-ink-dim)] hover:text-[var(--color-ink)] flex items-center gap-1.5"
        aria-label="Menu"
      >
        <span class="font-mono text-sm">menu</span>
        <svg class="chev transition-transform" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6" />
        </svg>
      </summary>
      <div class="absolute right-0 top-full mt-2 z-50 nav-menu rounded border border-[var(--color-line)] bg-[var(--color-surface)] p-2 flex flex-col font-mono text-sm shadow-lg">
        {
          links.map((l) => (
            <a
              href={l.href}
              rel={relFor(l)}
              data-umami-event={l.external ? l.umami : undefined}
            data-track={l.external ? undefined : l.umami}
            data-track-where={l.href === '/chronochasm' ? 'site-nav' : undefined}
            data-track-destination={l.href === '/chronochasm' ? l.href : undefined}
              aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
              class:list={['menu-link rounded hover:bg-[var(--color-base)]', ...linkClass(l)]}
            >
              {l.label}
            </a>
          ))
        }
      </div>
    </details>
  </nav>
</header>

<script>
  // Native disclosures work without JS; add familiar dismissal when it is available.
  document.addEventListener('click', (event) => {
    document.querySelectorAll<HTMLDetailsElement>('nav[aria-label="Primary"] details[open]').forEach((menu) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
  });
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('nav[aria-label="Primary"] details[open]').forEach((menu) => {
      if (menu.contains(document.activeElement)) menu.querySelector('summary')?.focus();
      menu.open = false;
    });
  });
</script>

<style>
  nav > div > a, .nav-disclosure { min-height: 44px; min-width: 44px; display: inline-flex; align-items: center; }
  .nav-disclosure { gap: 6px; list-style: none; }
  .nav-disclosure::-webkit-details-marker { display: none; }
  .nav-menu { width: 224px; max-height: calc(100dvh - 80px); overflow-y: auto; }
  .menu-link { min-height: 44px; padding: 10px 12px; display: flex; align-items: center; }
  nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
  @media (min-width: 640px) and (max-width: 899px) { nav > div { display: none; } nav > details { display: block; } }
  @media (min-width: 900px) { nav > div { gap: 20px; font-size: 14px; } }
</style>
