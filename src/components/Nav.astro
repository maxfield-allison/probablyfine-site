---
const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);

const links = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/labs', label: 'Labs' },
  { href: 'https://status.probablyfine.dev', label: 'Status', external: true },
];
---

<header class="border-b border-[--color-line]">
  <nav aria-label="Primary" class="max-w-3xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="/" class="font-mono text-sm text-[--color-ink] no-underline hover:no-underline">
      probably<span class="text-[--color-accent]">fine</span>
    </a>
    <div class="flex items-center gap-6 font-mono text-sm">
      {
        links.map((l) => (
          <a
            href={l.href}
            rel={l.external ? 'noopener' : undefined}
            aria-current={!l.external && isActive(l.href) ? 'page' : undefined}
            class:list={[
              'no-underline hover:no-underline transition-colors',
              !l.external && isActive(l.href)
                ? 'text-[--color-ink]'
                : 'text-[--color-ink-dim] hover:text-[--color-ink]',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
