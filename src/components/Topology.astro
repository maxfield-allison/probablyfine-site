---
// A layered topology of the lab, drawn as inline SVG so it scales cleanly and
// ships as static markup (no client JS, no image request). Deliberately leaves
// out addressing, VLAN IDs, and subnets, same as the Labs tables. It is a shape
// of how traffic flows, not a wiring diagram.
//
// Colors resolve from the site theme CSS variables (:root), so it stays on-brand
// on either site if reused.

interface Band {
  label: string;
  sub: string;
  chips?: string[];
}

const bands: Band[] = [
  { label: 'Internet', sub: 'the hostile side' },
  { label: 'Cloudflare', sub: 'DNS + proxied edge' },
  { label: 'OPNsense', sub: 'HA firewall pair, CARP failover' },
  { label: 'Brocade ICX6610', sub: '10GbE core, jumbo frames' },
  { label: 'Proxmox + Ceph', sub: 'five nodes, ~230 TiB raw', chips: ['pve-00', 'pve-01', 'pve-02', 'pve-03', 'pve-04'] },
  { label: 'Talos Kubernetes', sub: 'nine nodes, ArgoCD GitOps', chips: ['control x3', 'worker x6', 'GPU x3'] },
  { label: 'Raspberry Pi fleet', sub: 'out-of-band + home automation' },
];

// Layout math. Everything is centered in a 640-wide viewBox. Bands with a chip
// row are taller so the chips sit on their own line beneath the label.
const W = 640;
const bandW = 460;
const bandX = (W - bandW) / 2;
const top = 16;
const baseH = 60;
const chipRowH = 34;
const gap = 28; // vertical connector space between bands

// Precompute each band's y and height, accumulating downward.
let cursor = top;
const laid = bands.map((band) => {
  const h = baseH + (band.chips ? chipRowH : 0);
  const y = cursor;
  cursor += h + gap;
  return { band, y, h };
});
const H = cursor - gap + 16;
---

<figure class="mt-4 overflow-x-auto rounded border border-[--color-line] bg-[--color-surface]/40 p-4">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    width="100%"
    role="img"
    aria-label="Layered topology of the homelab: internet to Cloudflare to an OPNsense HA firewall pair, a 10GbE Brocade core, a five-node Proxmox and Ceph cluster, a nine-node Talos Kubernetes cluster with GPUs, and a Raspberry Pi fleet."
    class="min-w-[520px] font-mono"
  >
    {
      laid.map(({ band, y, h }, i) => {
        const cx = W / 2;
        return (
          <g>
            {i > 0 && (
              <line
                x1={cx}
                y1={y - gap}
                x2={cx}
                y2={y}
                stroke="var(--color-line)"
                stroke-width="2"
              />
            )}
            <rect
              x={bandX}
              y={y}
              width={bandW}
              height={h}
              rx="8"
              fill="var(--color-base)"
              stroke="var(--color-line)"
            />
            <rect x={bandX} y={y} width="4" height={h} rx="2" fill="var(--color-accent)" />
            <text x={bandX + 20} y={y + 27} fill="var(--color-ink)" font-size="16" font-weight="600">
              {band.label}
            </text>
            <text x={bandX + 20} y={y + 47} fill="var(--color-ink-dim)" font-size="12">
              {band.sub}
            </text>
            {band.chips &&
              band.chips.map((chip, ci) => {
                const chipW = 76;
                const chipGap = 8;
                const chipX = bandX + 20 + ci * (chipW + chipGap);
                const chipY = y + baseH - 4;
                return (
                  <g>
                    <rect
                      x={chipX}
                      y={chipY}
                      width={chipW}
                      height="22"
                      rx="4"
                      fill="var(--color-surface)"
                      stroke="var(--color-line)"
                    />
                    <text
                      x={chipX + chipW / 2}
                      y={chipY + 15}
                      fill="var(--color-accent)"
                      font-size="11"
                      text-anchor="middle"
                    >
                      {chip}
                    </text>
                  </g>
                );
              })}
          </g>
        );
      })
    }
  </svg>
  <figcaption class="text-[--color-ink-dim] text-xs mt-3 leading-relaxed">
    How traffic flows, top to bottom. Addressing and VLANs left out on purpose.
  </figcaption>
</figure>
