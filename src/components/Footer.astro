---
// Shape kept deliberately identical to personal-site/src/components/Footer.astro:
// the identity link row and the cross-site network strip are the verbatim layer
// shared by both sites. Only the tagline, the trailing site-specific link
// (RSS here, Source there), and which domain carries the accent differ.
// Edit both together.
import Icon from './Icon.astro';
const year = new Date().getFullYear();

// Set to "pages" by the Cloudflare Pages job in .github/workflows/deploy.yml.
// The container build leaves it unset and gets the default, so the two
// artifacts are distinguishable without either one having to detect anything
// at runtime. Any unexpected value is treated as the normal case rather than
// the alarming one: a typo in a workflow should not put a degraded banner on
// every page.
const isFailover = import.meta.env.PUBLIC_ORIGIN === 'pages';
---

<footer class="border-t border-[var(--color-line)] mt-24">
  <div
    class="max-w-[var(--container-shell)] mx-auto px-6 py-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 font-mono text-xs text-[var(--color-ink-dim)]"
  >
    <div>
      <p>© {year} Maxfield Allison · it's probably fine</p>
      <p class="mt-1 text-[var(--color-ink-dim)]">Feel free to reach out.</p>
    </div>
    <div class="flex flex-wrap gap-x-5 gap-y-2">
      <a href="mailto:maxfield.allison@gmail.com" rel="me" data-umami-event="email-click" class="inline-flex items-center gap-1.5">
        <Icon name="email" size={14} /> Email
      </a>
      <a href="https://github.com/maxfield-allison" rel="me noopener" data-umami-event="outbound-github" class="inline-flex items-center gap-1.5">
        <Icon name="github" size={14} /> GitHub
      </a>
      <a href="https://www.linkedin.com/in/maxfield-allison/" rel="me noopener" data-umami-event="outbound-linkedin" class="inline-flex items-center gap-1.5">
        <Icon name="linkedin" size={14} /> LinkedIn
      </a>
      <a href="https://bsky.app/profile/maxfieldallison.com" rel="me noopener" data-umami-event="outbound-bluesky" class="inline-flex items-center gap-1.5">
        <Icon name="bluesky" size={14} /> Bluesky
      </a>
      <a href="https://www.facebook.com/maxfield.allison" rel="me noopener" data-umami-event="outbound-facebook" class="inline-flex items-center gap-1.5">
        <Icon name="facebook" size={14} /> Facebook
      </a>
      <a href="/rss.xml" data-umami-event="rss-subscribe" class="inline-flex items-center gap-1.5">
        <Icon name="rss" size={14} /> RSS
      </a>
    </div>
  </div>
  <div class="max-w-[var(--container-shell)] mx-auto px-6 pb-10 space-y-2">
    <p class="font-mono text-[11px] text-[var(--color-ink-dim)]">
      <a href="https://maxfieldallison.com?utm_source=probablyfine&utm_medium=site" rel="noopener" data-umami-event="outbound-maxfieldallison" class="hover:text-[var(--color-ink)]">maxfieldallison.com</a>
      <span class="text-[var(--color-ink-dim)]"> · </span>
      <span class="text-[var(--color-accent)]">probablyfine.dev</span>
      <span class="text-[var(--color-ink-dim)]">. Two sites, one person.</span>
    </p>
    {/* Which build produced this page.

        The container image and the Cloudflare Pages mirror are built by two
        separate jobs, so the Pages job can stamp PUBLIC_ORIGIN=pages and the
        container build gets the default. That makes this the rare status
        indicator that is true by construction rather than asserted: no fetch,
        no client JS, just a string decided at build time.

        Read it precisely. It reports which build is answering, not the health
        of the cluster — Cloudflare can still serve cached HTML from the k8s
        origin while k8s is down, and that page would say k8s. The label says
        "serving" rather than "up" for exactly that reason.

        Amber, not red: the mirror answering is degraded, not broken, and the
        reader is looking at a working page. It pulses only in that state, so
        motion here always means something is actually different right now. */}
    <p class="font-mono text-[11px] text-[var(--color-ink-dim)]">
      {
        isFailover ? (
          <>
            <span class="origin-dot origin-dot--warn" aria-hidden="true" />
            <span class="text-[var(--color-warn)]">serving from the Cloudflare Pages mirror</span>
            <span> · the cluster is not answering</span>
          </>
        ) : (
          <>
            <span class="origin-dot" aria-hidden="true" />
            <span>serving from the Kubernetes cluster</span>
          </>
        )
      }
    </p>
    {/* Privacy has to be reachable from every page, not just linked from the
        comment widget's footer. A commenter should be able to read what gets
        stored before they decide to type anything. */}
    <p class="font-mono text-[11px] text-[var(--color-ink-dim)]">
      <a href="/ai" class="hover:text-[var(--color-ink)]">AI policy</a>
      <span class="text-[var(--color-ink-dim)]"> · </span>
      <a href="/privacy" class="hover:text-[var(--color-ink)]">Privacy</a>
      <span class="text-[var(--color-ink-dim)]"> · </span>
      <a href="/accessibility" class="hover:text-[var(--color-ink)]">Accessibility</a>
    </p>
  </div>
</footer>

<style>
  /* The dot is punctuation for the line beside it, so it is aria-hidden and
     the sentence carries the meaning on its own. */
  .origin-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.5em;
    border-radius: 50%;
    vertical-align: baseline;
    background-color: color-mix(in srgb, var(--color-accent) 70%, transparent);
  }

  /* Only the degraded state moves. This is a time-based animation rather than
     a scroll-driven one, so the global reduced-motion block does stop it. */
  .origin-dot--warn {
    background-color: var(--color-warn);
    animation: origin-pulse 2.4s ease-in-out infinite;
  }

  @keyframes origin-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }
</style>
