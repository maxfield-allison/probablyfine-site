import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

// The companion page to fourteen-years-of-receipts, which quotes my wife's verdict
// on the homelab spend — "still cheaper than the 'zoo'" — and then says "we have a
// lot of animals" without proving it. This is the proof.
//
// Structurally this is /labs pointed at livestock: same prompt line, same stat
// strip, same grouped inventory. That is the joke, and it only works if the format
// is played straight.
//
// Unlike /labs, this page uses astro:image rather than a bare <img>. Sixty-odd
// photographs is where build-time resizing stops being optional; every photo in
// src/assets/pets is a 1200px source that Astro cuts down to the size the grid
// actually paints.
//
// Every file in src/assets/pets came through scripts/photo-import.mjs, which strips
// all metadata. 62 of the 64 originals carried GPS coordinates. Do not hand-copy a
// photo into this directory.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/pets/*.jpg', {
  eager: true,
});
const photo = (name: string) => {
  const found = images[`../assets/pets/${name}.jpg`];
  if (!found) throw new Error(`No photo src/assets/pets/${name}.jpg — check the name.`);
  return found.default;
};

interface Shot {
  file: string;
  /** Read aloud by screen readers. Describes the frame. */
  alt: string;
  /** Shown under the photo in the overlay. Falls back to the animal and the year. */
  caption?: string;
}
interface Animal {
  name: string;
  aka?: string;
  kind: string;
  since?: string;
  /** A closing year is how this page says an animal has died. Nothing else marks it. */
  until?: string;
  note?: string;
  shots: Shot[];
}
interface Group {
  slug: string;
  heading: string;
  blurb?: string;
  animals: Animal[];
}

