      So here's the inventory, in the same format as <a href="/labs">the hardware</a>. It
      felt only fair.
    </p>
    <p class="font-mono text-xs text-[var(--color-ink-dim)] mt-4 mb-0">
      {total} animals · dates are the first photo I can find of them, which is not the
      day they turned up · a closed range means they're no longer with us · click any
      photo
    </p>
  </section>

  {/* Stat strip, same construction as /labs: hairlines between cells, rules top and
      bottom. Dividers come off nth-child rather than the loop index because which
      cell starts a row changes with the column count at each breakpoint. */}
  <section class="max-w-[var(--container-shell)] mx-auto px-6 mt-4">
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 border-t border-b border-[var(--color-line)]">
      {
        counts.map((c) => (
          <div class="py-5 px-4 border-[var(--color-line)] border-l [&:nth-child(2n+1)]:border-l-0 [&:nth-child(n+3)]:border-t sm:[&:nth-child(2n+1)]:border-l sm:[&:nth-child(4n+1)]:border-l-0 sm:[&:nth-child(n+3)]:border-t-0 sm:[&:nth-child(n+5)]:border-t lg:[&:nth-child(4n+1)]:border-l lg:[&:nth-child(7n+1)]:border-l-0 lg:[&:nth-child(n+5)]:border-t-0">
            <div class="font-mono text-2xl text-[var(--color-accent)] leading-none">{c.value}</div>
            <div class="font-mono text-[11px] text-[var(--color-ink-dim)] mt-1.5 leading-snug">{c.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  {
    groups.map((g) => (
      <section id={g.slug} class="max-w-[var(--container-shell)] mx-auto px-6 pt-12 pb-2">
        <h2 class="font-mono text-sm text-[var(--color-accent)] m-0 mb-2"># {g.heading}</h2>
        {g.blurb && (
          <p class="text-[var(--color-ink-dim)] m-0 mb-6 leading-[1.65] text-pretty max-w-[62ch]">
            {g.blurb}
          </p>
        )}
        <div class="grid gap-10 md:grid-cols-2">
          {g.animals.map((a) => (
            <article class="m-0 border-t border-[var(--color-line)] pt-5">
              <div
                class="grid gap-2"
                style={`grid-template-columns: repeat(${Math.min(a.shots.length, 3)}, minmax(0, 1fr))`}
              >
                {a.shots.map((s) => (
                  <button
                    type="button"
                    data-shot
                    data-full={photo(s.file).src}
                    data-alt={s.alt}
                    data-caption={captionFor(a, s)}
                    class="p-0 border-0 bg-transparent cursor-zoom-in block rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
                  >
                    <Image
                      src={photo(s.file)}
                      alt={s.alt}
                      widths={[280, 560]}
                      sizes="(min-width: 768px) 200px, 33vw"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover aspect-square border border-[var(--color-line)] rounded-md block"
                    />
                  </button>
                ))}
              </div>
              <p class="mt-3 mb-0 font-mono text-sm">
                <span class="text-[var(--color-ink)]">{a.name}</span>
                {a.aka && <span class="text-[var(--color-ink-dim)]"> "{a.aka}"</span>}
                <span class="text-[var(--color-ink-dim)]"> · {a.kind}</span>
                {a.since && <span class="text-[var(--color-ink-dim)]"> · {lifespan(a)}</span>}
              </p>
              {a.note && (
                <p class="text-[var(--color-ink-dim)] m-0 mt-1.5 leading-[1.65] text-pretty">
                  {a.note}
                </p>
              )}
            </article>
          ))}
        </div>
      </section>
    ))
  }

  <section class="max-w-[var(--container-shell)] mx-auto px-6 pt-12 pb-20">
    <h2 class="font-mono text-sm text-[var(--color-accent)] m-0 mb-2"># everyone at once</h2>
    <p class="text-[var(--color-ink-dim)] m-0 mb-6 leading-[1.65] text-pretty max-w-[62ch]">
      Listing them one at a time is the tidy version. This is what it's actually like.
    </p>
    <div class="grid gap-3 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
      {
        together.map((s) => (
          <button
            type="button"
            data-shot
            data-full={photo(s.file).src}
            data-alt={s.alt}
            data-caption={s.caption}
            class="p-0 border-0 bg-transparent cursor-zoom-in block rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]"
          >
            <Image
              src={photo(s.file)}
              alt={s.alt}
              widths={[320, 640]}
              sizes="(min-width: 1024px) 260px, (min-width: 640px) 33vw, 50vw"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover aspect-square border border-[var(--color-line)] rounded-md block"
            />
          </button>
        ))
      }
    </div>
  </section>
  {/* One overlay for the whole page. Every photo above is a button that opens it at its
      own index, and the arrows walk the page in the order it reads: cats, then dogs,
      then the rest, then the group shots. <dialog> is doing the real work here — it
      handles the top layer, the focus trap and the Escape key without any of it being
      reimplemented in JavaScript. */}
  <dialog
    id="lightbox"
    aria-label="Photos"
    class="p-0 m-0 w-full h-full max-w-full max-h-full bg-transparent text-[var(--color-ink)] backdrop:bg-black/85"
  >
    <div data-lb="close" class="relative w-full h-full flex items-center justify-center px-4 py-6">
      <button
        type="button"
        data-lb="close"
        aria-label="Close"
        class="absolute top-3 right-4 z-10 font-mono text-xs text-[var(--color-ink-dim)] hover:text-[var(--color-ink)] bg-transparent border border-[var(--color-line)] rounded px-2.5 py-1 cursor-pointer"
      >esc</button>
      <button
        type="button"
        data-lb="prev"
        aria-label="Previous photo"
        class="absolute left-2 sm:left-4 top-1/2 -translate-y-1/2 z-10 font-mono text-lg text-[var(--color-ink-dim)] hover:text-[var(--color-ink)] bg-[var(--color-base)]/70 border border-[var(--color-line)] rounded px-3 py-2 cursor-pointer"
      >&#8592;</button>
      <button
        type="button"
        data-lb="next"
        aria-label="Next photo"
        class="absolute right-2 sm:right-4 top-1/2 -translate-y-1/2 z-10 font-mono text-lg text-[var(--color-ink-dim)] hover:text-[var(--color-ink)] bg-[var(--color-base)]/70 border border-[var(--color-line)] rounded px-3 py-2 cursor-pointer"
      >&#8594;</button>

      <figure data-lb="stay" class="m-0 flex flex-col items-center gap-3 max-w-[min(94vw,1100px)]">
        <img
          id="lightbox-img"
          src=""
          alt=""
          class="max-w-full max-h-[74vh] w-auto h-auto object-contain rounded-md border border-[var(--color-line)]"
        />
        <figcaption class="font-mono text-xs text-[var(--color-ink-dim)] text-center leading-[1.6] text-pretty">
          <span id="lightbox-caption"></span>
          <span id="lightbox-count" class="text-[var(--color-accent)] ml-2"></span>
        </figcaption>
      </figure>
    </div>
  </dialog>
</Layout>

<script>
  // The overlay walks every photo on the page in DOM order, so left and right move from
  // one animal to the next rather than stopping at the end of a card.
  function setupLightbox() {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const caption = document.getElementById('lightbox-caption');
    const count = document.getElementById('lightbox-count');
    if (!dialog || !img || !caption || !count) return;

    const shots = Array.from(document.querySelectorAll<HTMLButtonElement>('button[data-shot]'));
    if (!shots.length) return;
    let index = 0;

    const show = (i: number) => {
      index = (i + shots.length) % shots.length;
      const shot = shots[index];
      img.src = shot.dataset.full ?? '';
      img.alt = shot.dataset.alt ?? '';
      caption.textContent = shot.dataset.caption ?? '';
      count.textContent = `${index + 1}/${shots.length}`;
    };

    shots.forEach((shot, i) => {
      if (shot.dataset.bound) return;
      shot.dataset.bound = '1';
      shot.addEventListener('click', () => {
        show(i);
        if (!dialog.open) dialog.showModal();
      });
    });

    if (dialog.dataset.bound) return;
    dialog.dataset.bound = '1';

    // One delegated handler. closest() finds the nearest element carrying an action, so
    // the arrows win over the backdrop they sit on, and the figure absorbs clicks on the
    // photo itself rather than letting them fall through and close the overlay.
    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      const action = target.closest<HTMLElement>('[data-lb]')?.dataset.lb;
      if (action === 'prev') show(index - 1);
      else if (action === 'next') show(index + 1);
      else if (action === 'close') dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        show(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        show(index + 1);
      }
    });

    // Drop the source on close so a reopened overlay never flashes the previous photo.
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
    });
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>
