---
import Layout from '../layouts/Layout.astro';
import Topology from '../components/Topology.astro';
import rack from '../content/posts/img/2025-basement-rack.jpg';

// A living tour of the hardware. Specs are captured periodically and drift over
// time. Network addressing, VLAN IDs, and subnets are deliberately left out.
const captured = 'July 2026';

const nodes = [
  { name: 'pve-00', cpu: 'AMD EPYC 7282', cores: '16C / 32T', ram: '256 GB ECC', gpu: 'RTX 4070 Ti + GTX 1660', role: 'Flagship compute / GPU' },
  { name: 'pve-01', cpu: 'Threadripper 2920X', cores: '12C / 24T', ram: '128 GB ECC', gpu: 'GTX 1080 Ti', role: 'Compute / GPU' },
  { name: 'pve-02', cpu: 'Core i7-6700', cores: '4C / 8T', ram: '64 GB', gpu: 'iGPU only', role: 'Capacity / quorum' },
  { name: 'pve-03', cpu: 'Core i7-6700', cores: '4C / 8T', ram: '48 GB', gpu: 'iGPU only', role: 'Capacity / quorum' },
  { name: 'pve-04', cpu: 'Core i7-7700', cores: '4C / 8T', ram: '32 GB', gpu: 'iGPU only', role: 'Capacity / quorum' },
];

const gpus = [
  { card: 'RTX 4070 Ti', arch: 'Ada Lovelace', host: 'pve-00', target: 'K8s GPU worker (time-sliced, 2 slots)' },
  { card: 'GTX 1660', arch: 'Turing', host: 'pve-00', target: 'K8s GPU worker (time-sliced, 2 slots)' },
  { card: 'GTX 1080 Ti', arch: 'Pascal', host: 'pve-01', target: 'K8s GPU worker (time-sliced, 3 slots)' },
];

const pis = [
  { name: 'ocisly', model: 'Raspberry Pi 5 (16 GB)', storage: '2 TB NVMe via PCIe HAT', role: 'Home automation primary', status: 'Live' },
  { name: 'mistakenot', model: 'Raspberry Pi 5 (8 GB)', storage: '512 GB NVMe', role: 'IaC toolchain and edge services', status: 'Live' },
  { name: 'flere', model: 'Raspberry Pi 4 (4 GB)', storage: 'microSD / USB', role: 'Lightweight services', status: 'Idle' },
];

const power = [
  { node: 'pve-00', chassis: 'Rosewill RSV-L4412 4U (12 hot-swap bays)', psu: 'EVGA SuperNOVA 1600 P2 (Platinum)' },
  { node: 'pve-01', chassis: 'Corsair Carbide 330R mid-tower', psu: 'EVGA SuperNOVA 850 T2 (Titanium)' },
  { node: 'pve-02/03/04', chassis: 'HP EliteDesk 800 G2 SFF (stock)', psu: 'HP stock SFF' },
];

// Aggregate scale, the numbers that make the point without a spec dump.
const stats: { value: string; unit?: string; label: string }[] = [
  { value: '9', label: 'Talos K8s nodes' },
  { value: '51', label: 'applications, GitOps' },
  { value: '~230', unit: 'TiB', label: 'Ceph raw' },
  { value: '3', label: 'GPU generations' },
  { value: '40C/80T', label: 'cluster CPU' },
  { value: '528', unit: 'GB', label: 'cluster RAM' },
];

// The software that actually earns its keep. Grouped, not exhaustive, and it
// drifts as I add and retire things.
const services = [
  {
    group: 'media',
    blurb: 'The reason any of this started.',
    items: 'Plex, the full *arr automation stack, request management, and download clients pinned behind a VPN.',
  },
  {
    group: 'home',
    blurb: 'Runs on the Pi fleet so it survives cluster maintenance.',
    items: 'Home Assistant, Frigate NVR with Coral TPU detection, Music Assistant, and a bag of Zigbee, Z-Wave, and Thread radios.',
  },
  {
    group: 'personal cloud',
    blurb: "The stuff I'd otherwise rent from someone else.",
    items: 'Nextcloud, a recipe box, a wiki, and Penpot for design.',
  },
  {
    group: 'platform',
    blurb: 'The boring, important layer that keeps the rest honest.',
    items: 'Self-hosted GitLab with CI runners, Prometheus and Grafana plus Graylog for observability, Authentik for SSO, Infisical and Vaultwarden for secrets, Umami for analytics, and a public status page.',
  },
];
---

<Layout title="Labs · ProbablyFine" description="A living tour of the hardware behind the homelab: a five-node Proxmox cluster, Ceph storage, a 10GbE fabric, three GPU generations, and a fleet of Raspberry Pis.">
  {/* Hero: the claim on the left, the evidence on the right. The rack photo
      belongs above the fold because this page's whole job is making "I actually
      run this" undeniable, and a picture of the thing does that faster than any
      amount of prose about it. */}
  <section class="max-w-[var(--container-shell)] mx-auto px-6 pt-16 pb-8">
    <div class="grid gap-8 md:gap-10 md:grid-cols-[1.15fr_1fr] items-start">
      <div>
        <p class="font-mono text-sm text-[var(--color-accent)] m-0">$ lscpu --lab</p>
        <h1 class="text-[2.125rem] font-bold mt-3.5 mb-0 tracking-[-0.015em]">The lab</h1>
        <p class="text-[var(--color-ink-dim)] mt-4 mb-0 leading-[1.65] text-pretty">
          This is the hardware the blog keeps talking about. Five Proxmox nodes, a Ceph pool
          measured in hundreds of terabytes, a 10GbE fabric with jumbo frames, three different
          NVIDIA generations, and a small fleet of Raspberry Pis doing the jobs that should never
          share a failure domain with everything else. It's over-built on purpose. That's the
          whole point.
        </p>
        <p class="font-mono text-xs text-[var(--color-ink-dim)] mt-4 mb-0">
          captured {captured} · addressing and VLAN details left out on purpose
        </p>
      </div>

      <figure class="m-0">
        <img
          src={rack.src}
          width={rack.width}
          height={rack.height}
          alt="The homelab rack in a basement corner: a 4U EPYC node, three small form-factor machines, and a switch"
          loading="eager"
          decoding="async"
          class="w-full h-auto border border-[var(--color-line)] rounded-md block"
        />
        <figcaption class="flex gap-2.5 mt-2.5 font-mono text-[11px] text-[var(--color-ink-dim)] leading-[1.6]">
          <span class="text-[var(--color-accent)] shrink-0">fig 01</span>
          <span>The whole cluster, in one corner of a basement. It is probably fine.</span>
        </figcaption>
      </figure>
    </div>
  </section>

  {/* Stats strip. A single ruled row, hairlines between cells, top and bottom
      rules closing it: the aggregate scale stated plainly. Units drop to a
      smaller step inside the number so the figure stays the thing you read.

      Dividers are driven by nth-child rather than the loop index, because which
      cell starts a row changes with the column count at each breakpoint. Every
      cell carries a left rule; the first in each row drops it, and rows after
      the first gain a top rule. */}
  <section class="max-w-[var(--container-shell)] mx-auto px-6 mt-4">
    <div class="reveal grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 border-t border-b border-[var(--color-line)]">
      {
        stats.map((s, i) => (
          <div
            class="py-5 px-4 border-[var(--color-line)] border-l [&:nth-child(2n+1)]:border-l-0 [&:nth-child(n+3)]:border-t sm:[&:nth-child(2n+1)]:border-l sm:[&:nth-child(3n+1)]:border-l-0 sm:[&:nth-child(n+3)]:border-t-0 sm:[&:nth-child(n+4)]:border-t lg:[&:nth-child(3n+1)]:border-l lg:[&:nth-child(6n+1)]:border-l-0 lg:[&:nth-child(n+4)]:border-t-0"
          >
            <div class="font-mono text-2xl text-[var(--color-accent)] leading-none">
              {s.value}
              {s.unit && <span class="text-sm">{' '}{s.unit}</span>}
            </div>
            <div class="font-mono text-[11px] text-[var(--color-ink-dim)] mt-1.5 leading-snug">{s.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Topology -->
  <section class="reveal max-w-[var(--container-shell)] mx-auto px-6 py-8">
    <h2 class="font-mono text-sm text-[var(--color-accent)]"># how it fits together</h2>
    <p class="text-[var(--color-ink-dim)] text-sm mt-3 max-w-2xl leading-relaxed">
      One diagram for the whole shape of it. Traffic comes in from the top, through the edge
      and the firewall, across the 10GbE core, and down onto the compute and storage that
      run the workloads. The Pi fleet hangs off to the side on purpose, so home
      automation keeps working when the cluster is down for maintenance.
    </p>
    <Topology />
  </section>

  <!-- Cluster -->
  <section class="reveal max-w-[var(--container-shell)] mx-auto px-6 py-8">
    <h2 class="font-mono text-sm text-[var(--color-accent)]"># the cluster</h2>
    <div class="mt-4 overflow-x-auto rounded border border-[var(--color-line)]">
      <table class="w-full text-sm">
        <thead class="font-mono text-xs text-[var(--color-ink-dim)] border-b border-[var(--color-line)]">
          <tr>
            <th class="text-left font-normal px-4 py-3">Node</th>
            <th class="text-left font-normal px-4 py-3">CPU</th>
            <th class="text-left font-normal px-4 py-3">Cores</th>
            <th class="text-left font-normal px-4 py-3">RAM</th>
            <th class="text-left font-normal px-4 py-3">GPU</th>
          </tr>
        </thead>
        <tbody>
          {
            nodes.map((n) => (
              <tr class="border-b border-[var(--color-line)] last:border-0">
                <td class="px-4 py-3 font-mono text-[var(--color-accent)] whitespace-nowrap">{n.name}</td>
                <td class="px-4 py-3 whitespace-nowrap">{n.cpu}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)] whitespace-nowrap">{n.cores}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)] whitespace-nowrap">{n.ram}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)]">{n.gpu}</td>
              </tr>
            ))
          }
        </tbody>
        <tfoot class="font-mono text-xs text-[var(--color-ink-dim)] border-t border-[var(--color-line)]">
          <tr>
            <td class="px-4 py-3">totals</td>
            <td class="px-4 py-3">5 nodes</td>
            <td class="px-4 py-3">40C / 80T</td>
            <td class="px-4 py-3">528 GB</td>
            <td class="px-4 py-3">3 discrete GPUs</td>
          </tr>
        </tfoot>
      </table>
    </div>
    <p class="text-[var(--color-ink-dim)] text-sm mt-4 leading-relaxed">
      Two tiers on purpose. pve-00 and pve-01 are the heavy compute and GPU hosts, both on
      ECC memory, with discrete NVIDIA cards passed through to Kubernetes workers. The three
      HP small-form-factor boxes are consumer hardware doing honest work as quorum and Ceph
      OSD hosts. Not everything needs to be a server to be useful.
    </p>
  </section>

  <!-- GPUs -->
  <section class="reveal max-w-[var(--container-shell)] mx-auto px-6 py-8">
    <h2 class="font-mono text-sm text-[var(--color-accent)]"># three GPU generations</h2>
    <p class="text-[var(--color-ink-dim)] text-sm mt-3 max-w-2xl leading-relaxed">
      Three NVIDIA architectures, each passed straight through to a Talos Kubernetes worker.
      All three are time-sliced, so several workloads share a card instead of one pinning it.
      I looked at NVIDIA's MPS first and turned it down: it sets exclusive compute mode, which
      blocks the NVENC and NVDEC engines the transcoding and camera detection depend on.
      Transcode, local inference, and the occasional experiment all land here.
    </p>
    <div class="mt-4 overflow-x-auto rounded border border-[var(--color-line)]">
      <table class="w-full text-sm">
        <thead class="font-mono text-xs text-[var(--color-ink-dim)] border-b border-[var(--color-line)]">
          <tr>
            <th class="text-left font-normal px-4 py-3">Card</th>
            <th class="text-left font-normal px-4 py-3">Architecture</th>
            <th class="text-left font-normal px-4 py-3">Host</th>
            <th class="text-left font-normal px-4 py-3">Passed to</th>
          </tr>
        </thead>
        <tbody>
          {
            gpus.map((g) => (
              <tr class="border-b border-[var(--color-line)] last:border-0">
                <td class="px-4 py-3 whitespace-nowrap">{g.card}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)] whitespace-nowrap">{g.arch}</td>
                <td class="px-4 py-3 font-mono text-[var(--color-accent)] whitespace-nowrap">{g.host}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)]">{g.target}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <!-- Storage -->
  <section class="reveal max-w-[var(--container-shell)] mx-auto px-6 py-8">
    <h2 class="font-mono text-sm text-[var(--color-accent)]"># storage</h2>
    <p class="text-[var(--color-ink-dim)] text-sm mt-3 max-w-2xl leading-relaxed">
      Everything sits on Ceph, on the order of 230 TiB raw spread across every node. Spinning
      disks make up the bulk pool, NVMe backs the fast pool and local VM storage, and a couple
      of Intel Optane drives handle metadata. The big NVMe counts hang off ASUS Hyper M.2
      carrier cards using PCIe bifurcation. This is the layer that taught me the most, mostly
      the hard way, which is a story the blog gets into. Backups run to a dedicated Proxmox
      Backup Server, because "I have backups" and "I have tested restores" are not the same
      sentence.
    </p>
  </section>

  <!-- Network -->
  <section class="reveal max-w-[var(--container-shell)] mx-auto px-6 py-8">
    <h2 class="font-mono text-sm text-[var(--color-accent)]"># the fabric</h2>
    <p class="text-[var(--color-ink-dim)] text-sm mt-3 max-w-2xl leading-relaxed">
      A Brocade ICX6610 sits at the core, with 10GbE SFP+ uplinks to every node and jumbo
      frames end to end. Each node runs a two-bridge, VLAN-aware layout over two 10GbE links:
      one trunk carries tenant and VM traffic, the other isolates the latency-sensitive
      storage and cluster replication on its own physical port. That split is what lets a
      firewall VM live-migrate between nodes without dropping a packet. Routing between the
      dozen or so segments is handled by a high-availability OPNsense pair with CARP failover.
    </p>
    <p class="text-[var(--color-ink-dim)] text-sm mt-4 max-w-2xl leading-relaxed">
      The per-node 10GbE cards are a museum of whatever was good and cheap at the time: Intel
      X550, Mellanox ConnectX-3 Pro, and Chelsio T320. They all do the same job. Edge
      switching and wireless are UniFi, and an APC UPS with a network card keeps the rack
      alive long enough to shut down cleanly.
    </p>
  </section>

  <!-- Pi fleet -->
  <section class="reveal max-w-[var(--container-shell)] mx-auto px-6 py-8">
    <h2 class="font-mono text-sm text-[var(--color-accent)]"># the pi fleet</h2>
    <p class="text-[var(--color-ink-dim)] text-sm mt-3 max-w-2xl leading-relaxed">
      A handful of Raspberry Pis run the things that should keep working even when the cluster
      is down for maintenance, mainly home automation and out-of-band tooling. They are named
      after Culture ships, which felt appropriate for machines whose entire job is to be
      quietly competent.
    </p>
    <div class="mt-4 overflow-x-auto rounded border border-[var(--color-line)]">
      <table class="w-full text-sm">
        <thead class="font-mono text-xs text-[var(--color-ink-dim)] border-b border-[var(--color-line)]">
          <tr>
            <th class="text-left font-normal px-4 py-3">Host</th>
            <th class="text-left font-normal px-4 py-3">Model</th>
            <th class="text-left font-normal px-4 py-3">Storage</th>
            <th class="text-left font-normal px-4 py-3">Role</th>
          </tr>
        </thead>
        <tbody>
          {
            pis.map((p) => (
              <tr class="border-b border-[var(--color-line)] last:border-0">
                <td class="px-4 py-3 font-mono text-[var(--color-accent)] whitespace-nowrap">{p.name}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)] whitespace-nowrap">{p.model}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)] whitespace-nowrap">{p.storage}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)]">{p.role}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="text-[var(--color-ink-dim)] text-sm mt-4 max-w-2xl leading-relaxed">
      They share a small bag of USB radios that move between nodes as needed: a Z-Wave
      controller, a multiprotocol Zigbee/Thread stick, and a Google Coral TPU for edge ML.
    </p>
  </section>

  <!-- What it runs -->
  <section class="reveal max-w-[var(--container-shell)] mx-auto px-6 py-8">
    <h2 class="font-mono text-sm text-[var(--color-accent)]"># what it runs</h2>
    <p class="text-[var(--color-ink-dim)] text-sm mt-3 max-w-2xl leading-relaxed">
      The hardware is only half the story. Here's what runs on it, grouped and
      not exhaustive. It drifts as I add and retire things.
    </p>
    <div class="mt-4 space-y-4">
      {
        services.map((s) => (
          <div class="rounded border border-[var(--color-line)] p-4">
            <div class="font-mono text-sm text-[var(--color-accent)]"># {s.group}</div>
            <p class="text-[var(--color-ink)] text-sm mt-2">{s.items}</p>
            <p class="text-[var(--color-ink-dim)] text-xs mt-1 italic">{s.blurb}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Power -->
  <section class="max-w-[var(--container-shell)] mx-auto px-6 py-8 pb-16">
    <h2 class="font-mono text-sm text-[var(--color-accent)]"># chassis and power</h2>
    <div class="mt-4 overflow-x-auto rounded border border-[var(--color-line)]">
      <table class="w-full text-sm">
        <thead class="font-mono text-xs text-[var(--color-ink-dim)] border-b border-[var(--color-line)]">
          <tr>
            <th class="text-left font-normal px-4 py-3">Node</th>
            <th class="text-left font-normal px-4 py-3">Chassis</th>
            <th class="text-left font-normal px-4 py-3">PSU</th>
          </tr>
        </thead>
        <tbody>
          {
            power.map((p) => (
              <tr class="border-b border-[var(--color-line)] last:border-0">
                <td class="px-4 py-3 font-mono text-[var(--color-accent)] whitespace-nowrap">{p.node}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)]">{p.chassis}</td>
                <td class="px-4 py-3 text-[var(--color-ink-dim)]">{p.psu}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="text-[var(--color-ink-dim)] text-sm mt-6 leading-relaxed">
      Want the story behind all this instead of the spec sheet? The{' '}
      <a href="/blog">blog</a>{' '}
      has the how-it-got-here and the incidents that shaped it.
    </p>
  </section>
</Layout>
