---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Comments from '../../components/Comments.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // newer = previous in reading order, older = next
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { title, description, date, tags, aiAssisted } = post.data;
const { Content } = await render(post);
const dateStr = date.toISOString().slice(0, 10);

const site = Astro.site ?? 'https://probablyfine.dev';
const postUrl = new URL(`/blog/${post.id}`, site).href;
// ?v bump forces social scrapers (LinkedIn caches OG images ~7d) to re-fetch
// after a card regeneration. Bump when the OG template/fonts change.
const ogImage = `/og/${post.id}.png?v=2`;
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  url: postUrl,
  image: new URL(ogImage, site).href,
  mainEntityOfPage: postUrl,
  keywords: tags.join(', '),
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: 'Maxfield Allison',
    url: 'https://maxfieldallison.com',
  },
  publisher: {
    '@type': 'Person',
    name: 'Maxfield Allison',
    url: 'https://maxfieldallison.com',
  },
};
---

<Layout title={`${title} — ProbablyFine`} description={description} ogImage={ogImage}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} slot="head" />
  <article class="max-w-3xl mx-auto px-6 pt-16 pb-12">
    <a href="/blog" class="font-mono text-xs text-[--color-ink-dim] hover:text-[--color-ink] no-underline hover:no-underline">&larr; all posts</a>
    <h1 class="text-3xl sm:text-4xl font-bold mt-4 leading-tight">{title}</h1>
    <div class="flex flex-wrap items-center gap-3 mt-4 font-mono text-xs text-[--color-ink-dim]">
      <time datetime={dateStr}>{dateStr}</time>
      {tags.map((t) => <span>#{t}</span>)}
      {aiAssisted && <span class="text-[--color-warn]">ai-assisted</span>}
    </div>

    <div class="prose mt-10">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav
          aria-label="More posts"
          class="mt-16 pt-8 border-t border-[--color-line] grid gap-4 sm:grid-cols-2 font-mono text-sm"
        >
          {older ? (
            <a href={`/blog/${older.id}`} class="group block no-underline hover:no-underline">
              <div class="text-xs text-[--color-ink-dim]">&larr; older</div>
              <div class="text-[--color-ink-dim] group-hover:text-[--color-accent] transition-colors mt-1">
                {older.data.title}
              </div>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={`/blog/${newer.id}`} class="group block no-underline hover:no-underline sm:text-right">
              <div class="text-xs text-[--color-ink-dim]">newer &rarr;</div>
              <div class="text-[--color-ink-dim] group-hover:text-[--color-accent] transition-colors mt-1">
                {newer.data.title}
              </div>
            </a>
          )}
        </nav>
      )
    }
  </article>
  <Comments />
</Layout>
