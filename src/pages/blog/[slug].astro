---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReadTracker from '../../components/ReadTracker.astro';
import Comments from '../../components/Comments.astro';
import CopyCommands from '../../components/CopyCommands.astro';
import NullArticle from '../../components/NullArticle.astro';
import { Code } from 'astro:components';
import { sessionTheme, sessionTransformers } from '../../lib/session.mjs';
import { listed, readingTime, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', listed)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return posts.map((post, i) => {
    const tags = new Set(post.data.tags ?? []);
    // Related = other posts sharing the most tags, then most recent. Up to 3.
    const related = posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({ p, shared: (p.data.tags ?? []).filter((t) => tags.has(t)).length }))
      .filter((x) => x.shared > 0)
      .sort((a, b) => b.shared - a.shared || b.p.data.date.getTime() - a.p.data.date.getTime())
      .slice(0, 3)
      .map((x) => x.p);
    return {
      params: { slug: post.id },
      props: {
        post,
        // newer = previous in reading order, older = next
        newer: posts[i - 1] ?? null,
        older: posts[i + 1] ?? null,
        related,
      },
    };
  });
}

const { post, newer, older, related } = Astro.props;
const { title, description, date, tags, aiRole, draft, genre, outcome } = post.data;
const { Content, remarkPluginFrontmatter } = await render(post);
// The copy script ships only on a page with something to copy: a `$` command
// in the body (flagged by the command-flag plugin) or a finish-line command.
const hasCommands = Boolean(remarkPluginFrontmatter?.hasCommands || outcome);
const dateStr = date.toISOString().slice(0, 10);
const mins = readingTime(post.body);

const site = Astro.site ?? 'https://probablyfine.dev';
const postUrl = new URL(`/blog/${post.id}`, site).href;
// ?v bump forces social scrapers (LinkedIn caches OG images ~7d) to re-fetch
// after a card regeneration. Bump when the OG template/fonts change.
const ogImage = `/og/${post.id}.png?v=2`;
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  url: postUrl,
  image: new URL(ogImage, site).href,
  mainEntityOfPage: postUrl,
  keywords: tags.join(', '),
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: 'Maxfield Allison',
    url: 'https://maxfieldallison.com',
  },
  publisher: {
    '@type': 'Person',
    name: 'Maxfield Allison',
    url: 'https://maxfieldallison.com',
  },
};

// Breadcrumb trail for richer search results.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: postUrl },
  ],
};
import { aiRoleLabel, aiRoleColor } from '../../lib/aiRole';
---

<Layout title={`${title} · ProbablyFine`} description={description} ogImage={ogImage} ogType="article" noindex={draft}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <meta property="article:author" content="Maxfield Allison" />
    {tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>
  {/* The post shell is the container width; the header and prose hold the
      narrower reading measure inside it, so sessions, figures, and photographs
      break out wider without the text ever running long.

      data-pagefind-body scopes the /search index to the article: only pages
      carrying it are indexed, and only the text inside it, so nav, footer,
      listings and comments never match. The chrome inside the article (the
      prompt line, the date/tag row, older/newer and related posts) is marked
      data-pagefind-ignore for the same reason. */}
  <article
    data-pagefind-body
    data-pagefind-meta={`date:${dateStr}`}
    class="max-w-[var(--container-shell)] mx-auto px-6 pt-12 sm:pt-16 pb-12"
  >
    <header class="max-w-[var(--measure-read)] mx-auto">
      <p data-pagefind-ignore class="font-mono text-xs text-[var(--color-accent)] m-0">
        $ cd ./blog<span class="cursor" aria-hidden="true"></span>
      </p>
      <h1 class="text-[2rem] sm:text-[2.5rem] font-bold mt-5 leading-[1.15] tracking-[-0.01em]">{title}</h1>
      <p class="text-lg leading-[1.6] text-[var(--color-ink-dim)] mt-5 mb-0">{description}</p>
      <div data-pagefind-ignore class="flex flex-wrap items-center gap-3 mt-6 pt-4 border-t border-[var(--color-line)] font-mono text-xs text-[var(--color-ink-dim)]">
        {draft && <span class="chip chip-draft">draft</span>}
        {genre === 'tutorial' && <span class="chip">tutorial</span>}
        <time datetime={dateStr}>{dateStr}</time>
        <span>{mins} min read</span>
        {tags.map((t) => (
          <a href={`/blog/tags/${tagSlug(t)}`} data-track="post-tag" data-track-tag={t} data-track-where="post" class="no-underline hover:no-underline hover:text-[var(--color-accent)] transition-colors">#{t}</a>
        ))}
        <a href="/ai" style={`color: ${aiRoleColor(aiRole)}`} class="no-underline hover:underline" data-track="ai-role-chip" data-track-role={aiRole} data-track-where="post-header">{aiRoleLabel(aiRole)}</a>
      </div>
    </header>

    {
      outcome && (
        <section class="outcome max-w-[var(--measure-read)] mx-auto mt-10" aria-labelledby="outcome-title">
          <h2 id="outcome-title" class="outcome-label">What you end up with</h2>
          <p class="outcome-summary">{outcome.summary}</p>
          <Code
            code={`$ ${outcome.command}`}
            lang="bash"
            theme={sessionTheme}
            transformers={sessionTransformers}
            meta={`title="${outcome.host ?? 'finish line'}"`}
          />
        </section>
      )
    }

    {post.id === 'why-i-created-null' ? <NullArticle /> : (
      <div class="prose mt-10">
        <Content />
      </div>
    )}

    {
      (newer || older) && (
        <nav
          data-pagefind-ignore
          aria-label="More posts"
          class="mt-16 pt-8 border-t border-[var(--color-line)] grid gap-4 sm:grid-cols-2 font-mono text-sm"
        >
          {older ? (
            <a href={`/blog/${older.id}`} data-track="post-nav" data-track-dir="older" class="group block no-underline hover:no-underline">
              <div class="text-xs text-[var(--color-ink-dim)]">&larr; older</div>
              <div class="text-[var(--color-ink-dim)] group-hover:text-[var(--color-accent)] transition-colors mt-1">
                {older.data.title}
              </div>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={`/blog/${newer.id}`} data-track="post-nav" data-track-dir="newer" class="group block no-underline hover:no-underline sm:text-right">
              <div class="text-xs text-[var(--color-ink-dim)]">newer &rarr;</div>
              <div class="text-[var(--color-ink-dim)] group-hover:text-[var(--color-accent)] transition-colors mt-1">
                {newer.data.title}
              </div>
            </a>
          )}
        </nav>
      )
    }

    {
      related.length > 0 && (
        <section data-pagefind-ignore class="mt-12 pt-8 border-t border-[var(--color-line)]">
          <h2 class="font-mono text-sm text-[var(--color-ink-dim)]">related posts</h2>
          <ul class="mt-4 space-y-3">
            {related.map((r) => (
              <li>
                <a
                  href={`/blog/${r.id}`}
                  data-track="post-open"
                  data-track-where="related"
                  class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 no-underline hover:no-underline"
                >
                  <span class="text-[var(--color-ink)] group-hover:text-[var(--color-accent)] transition-colors">
                    {r.data.title}
                  </span>
                  <time
                    datetime={r.data.date.toISOString().slice(0, 10)}
                    class="font-mono text-xs text-[var(--color-ink-dim)] shrink-0"
                  >
                    {r.data.date.toISOString().slice(0, 10)}
                  </time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
  <Comments />

  <ReadTracker event="post-read" key="slug" id={post.id} />
  {/* Reading-note and link signals; emitted with a content hash. */}
  <script src="../../scripts/post-signals.js"></script>
  {hasCommands && <CopyCommands />}
</Layout>
