---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Comments from '../../components/Comments.astro';
import { readingTime, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // newer = previous in reading order, older = next
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { title, description, date, tags, aiAssisted } = post.data;
const { Content } = await render(post);
const dateStr = date.toISOString().slice(0, 10);
const mins = readingTime(post.body);

const site = Astro.site ?? 'https://probablyfine.dev';
const postUrl = new URL(`/blog/${post.id}`, site).href;
// ?v bump forces social scrapers (LinkedIn caches OG images ~7d) to re-fetch
// after a card regeneration. Bump when the OG template/fonts change.
const ogImage = `/og/${post.id}.png?v=2`;
const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  url: postUrl,
  image: new URL(ogImage, site).href,
  mainEntityOfPage: postUrl,
  keywords: tags.join(', '),
  inLanguage: 'en',
  author: {
    '@type': 'Person',
    name: 'Maxfield Allison',
    url: 'https://maxfieldallison.com',
  },
  publisher: {
    '@type': 'Person',
    name: 'Maxfield Allison',
    url: 'https://maxfieldallison.com',
  },
};

// Breadcrumb trail for richer search results.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${site}/blog` },
    { '@type': 'ListItem', position: 3, name: title, item: postUrl },
  ],
};
---

<Layout title={`${title} · ProbablyFine`} description={description} ogImage={ogImage} ogType="article">
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} slot="head" />
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <meta property="article:author" content="Maxfield Allison" />
    {tags.map((t) => <meta property="article:tag" content={t} />)}
  </Fragment>
  <article class="max-w-3xl mx-auto px-6 pt-16 pb-12">
    <a href="/blog" class="font-mono text-xs text-[var(--color-ink-dim)] hover:text-[var(--color-ink)] no-underline hover:no-underline">&larr; all posts</a>
    <h1 class="text-3xl sm:text-4xl font-bold mt-4 leading-tight">{title}</h1>
    <div class="flex flex-wrap items-center gap-3 mt-4 font-mono text-xs text-[var(--color-ink-dim)]">
      <time datetime={dateStr}>{dateStr}</time>
      <span>{mins} min read</span>
      {tags.map((t) => (
        <a href={`/blog/tags/${tagSlug(t)}`} class="no-underline hover:no-underline hover:text-[var(--color-accent)] transition-colors">#{t}</a>
      ))}
      {aiAssisted && <span class="text-[var(--color-warn)]">ai-assisted</span>}
    </div>

    <div class="prose mt-10">
      <Content />
    </div>

    {
      (newer || older) && (
        <nav
          aria-label="More posts"
          class="mt-16 pt-8 border-t border-[var(--color-line)] grid gap-4 sm:grid-cols-2 font-mono text-sm"
        >
          {older ? (
            <a href={`/blog/${older.id}`} class="group block no-underline hover:no-underline">
              <div class="text-xs text-[var(--color-ink-dim)]">&larr; older</div>
              <div class="text-[var(--color-ink-dim)] group-hover:text-[var(--color-accent)] transition-colors mt-1">
                {older.data.title}
              </div>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={`/blog/${newer.id}`} class="group block no-underline hover:no-underline sm:text-right">
              <div class="text-xs text-[var(--color-ink-dim)]">newer &rarr;</div>
              <div class="text-[var(--color-ink-dim)] group-hover:text-[var(--color-accent)] transition-colors mt-1">
                {newer.data.title}
              </div>
            </a>
          )}
        </nav>
      )
    }
  </article>
  <Comments />

  {/* Read-completion signal: fire a Umami event once the reader scrolls near the
      end of the post. Powers "read" goals/funnels beyond raw pageviews. No PII;
      only fires once per page, only if the analytics tracker is present.
      data-astro-rerun so it re-arms after a client-side (ClientRouter) nav. */}
  <script is:inline data-astro-rerun define:vars={{ slug: post.id }}>
    (() => {
      let fired = false;
      const onScroll = () => {
        if (fired) return;
        const doc = document.documentElement;
        const reached =
          (window.scrollY + window.innerHeight) / doc.scrollHeight >= 0.9;
        if (!reached) return;
        fired = true;
        window.removeEventListener('scroll', onScroll);
        if (window.umami) window.umami.track('post-read', { slug });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
    })();
  </script>
</Layout>
