---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import { collectTags, tagSlug } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  const tags = collectTags(posts);
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: {
      tag,
      posts: posts.filter((p) => (p.data.tags ?? []).some((t) => tagSlug(t) === slug)),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Layout title={`#${tag} · ProbablyFine`} description={`Posts tagged ${tag}.`}>
  <section class="max-w-[var(--container-shell)] mx-auto px-6 pt-16 pb-8">
    <p class="font-mono text-sm text-[var(--color-accent)]">$ grep -rl "#{tag}" ./blog</p>
    <h1 class="text-3xl font-bold mt-3">
      <span class="text-[var(--color-ink-dim)]">#</span>{tag}
    </h1>
    <p class="text-[var(--color-ink-dim)] mt-3 font-mono text-sm">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      {' · '}
      <a href="/blog/tags" class="hover:text-[var(--color-ink)] no-underline hover:no-underline">all tags</a>
      {' · '}
      <a href="/blog" class="hover:text-[var(--color-ink)] no-underline hover:no-underline">all posts</a>
    </p>
  </section>

  <section class="max-w-[var(--container-shell)] mx-auto px-6 pb-16">
    {posts.map((post) => <PostCard post={post} where="tag-page" />)}
  </section>
</Layout>
