---
import Layout from '../layouts/Layout.astro';
---

<Layout bare fullReload title="Chronochasm · ProbablyFine" description="A few weeks in the lab, told through connected stories and the conversations behind them." ogImage="/og/the-story-in-the-record.png">
  <Fragment slot="head">
    <link rel="stylesheet" href="/chronochasm/style.css?v=public-selection" />
    <link rel="stylesheet" href="/chronochasm/curated.css?v=public-selection" />
    <script is:inline defer src="/chronochasm/app.js?v=public-selection"></script>
  </Fragment>

<header class="site"><div class="title-row"><div class="product-brand"><a class="product-parent" href="/" data-track="chronochasm-link" data-track-where="header" data-track-destination="/" data-astro-reload>probablyfine</a><button class="product-home" id="timeline-home" aria-label="Chronochasm, return to beginning"><span class="product-title">Chronochasm<span class="preview-badge">preview</span></span></button></div><div class="title-actions"><a class="companion-link" href="/blog/the-story-in-the-record" data-track="chronochasm-link" data-track-where="header" data-track-destination="/blog/the-story-in-the-record" data-astro-reload>About this history</a><span id="current-date" class="current-date">AUG 18 — SEP 14</span><button id="browse-moments" class="browse-moments">Browse all moments</button></div></div><div class="title-nav"><nav id="lane-legend" class="lane-legend" aria-label="Timeline domains"></nav><div class="gap-controls" role="group" aria-label="Timeline gaps"><div><button id="expand-gaps">Expand all gaps</button><button id="collapse-gaps">Collapse all gaps</button></div><span id="gap-status" aria-live="polite"></span></div><label class="thread-filter"><span class="sr-only">Follow a thread</span><select id="thread-filter"><option value="all">All threads</option></select></label></div></header>
<main class="viewport" id="viewport" aria-label="History timeline" tabindex="0"><div class="timeline" id="timeline"><div class="intro"><p class="eyebrow">A FEW WEEKS IN THE LAB</p><h1>Follow a thread.</h1><p>A disc hunt, the work around it, and the ideas that kept growing.</p><p class="hint" id="edition-meta">Loading the selected history…</p><p class="time-explanation">Follow the lines. Hover to explore. Open a moment to read.</p></div><div id="marks"></div></div></main>
<aside class="dock" id="dock" aria-label="Timeline detail"><div class="dock-top"><button class="zoom-button" id="zoom-out" aria-label="Show more history">−</button><div class="depths"><button data-level="0" aria-pressed="true">Chapters</button><button data-level="1" aria-pressed="false">Moments</button><button data-level="2" aria-pressed="false">Hours</button></div><button class="zoom-button" id="zoom-in" aria-label="Look closer">+</button><button class="motion-toggle" id="motion-toggle" aria-label="Pause floating motion" aria-pressed="false">Ⅱ</button></div><div class="dock-hint" id="depth-hint">Scroll through time · − / + reveal detail</div></aside>
<section class="reader" id="reader" role="region" aria-labelledby="story-title" inert><div class="reader-header"><div class="reader-toolbar"><span id="reader-crumb"></span><button class="close" id="close-reader" aria-label="Close story and return to timeline">×</button></div><div id="reader-navigation"></div></div><div class="reader-scroll" id="reader-scroll"><article id="story"></article></div></section>
<dialog id="source" aria-labelledby="source-title"><div class="dialog-head"><span class="eyebrow" id="source-layer-label">BEHIND THIS PASSAGE</span><button class="close" id="close-source" aria-label="Close source">×</button></div><div class="source-scroll" id="source-scroll"><h2 id="source-title"></h2><p class="meta" id="source-meta"></p><p id="source-context"></p><div id="source-selection"></div><p class="meta" id="source-scope"></p></div></dialog>
<dialog id="moment-index" aria-labelledby="moment-index-title"><div class="dialog-head"><h2 id="moment-index-title">All moments</h2><button class="close" id="close-moment-index" aria-label="Close all moments">×</button></div><p class="meta" id="moment-index-count"></p><div id="moment-list"></div></dialog>
<div class="sr-only" aria-live="polite" id="announcement"></div>

</Layout>
