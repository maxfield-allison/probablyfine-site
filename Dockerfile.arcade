# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN python3 -m venv /opt/arcade-tools
ENV PATH="/opt/arcade-tools/bin:${PATH}"
COPY scripts/arcade/requirements.txt /app/scripts/arcade/requirements.txt
RUN pip install --no-cache-dir uv==0.12.7 -r /app/scripts/arcade/requirements.txt
COPY scripts/arcade /app/scripts/arcade
COPY public/arcade /app/public/arcade
# Sources and cores are pinned in scripts/arcade. Failed checksums fail the build.
RUN --mount=type=cache,target=/app/.arcade-cache python scripts/arcade/prepare.py
RUN --mount=type=cache,target=/root/.cache/uv python scripts/arcade/prepare-mac.py
RUN --mount=type=cache,target=/app/.arcade-cache python scripts/arcade/prepare-discs.py
RUN --mount=type=cache,target=/app/.arcade-cache node scripts/arcade/prepare-windows.mjs

FROM nginx:1.29-alpine
COPY arcade-nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=101:101 /app/.arcade-runtime /usr/share/nginx/html
RUN chown -R 101:101 /var/cache/nginx \
    && touch /run/nginx.pid && chown 101:101 /run/nginx.pid
USER 101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
CMD ["nginx", "-g", "daemon off;"]
