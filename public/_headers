# Cloudflare Pages headers for the failover mirror.
#
# The mirror serves the same static build as the K8s origin, but Pages does not
# run nginx.conf — so without this file the mirror answers with no CSP, no
# HSTS, and no framing protection. Failover would then silently drop every
# security header exactly when the site is already having a bad day.
#
# Keep in step with nginx.conf. The two are separate files by necessity, so a
# change to the policy has to be made in both places.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), vr=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://giscus.app; style-src 'self' 'unsafe-inline' https://giscus.app; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src https://giscus.app; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests

# The ZERO/DAY playtest build is a single self-contained file with its own
# inline script, so it gets a scoped policy rather than loosening the site.
/zeroday/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), vr=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'
